# ⚠️ فقط BOT_TOKEN و OWNER_ID لازم‌اند. بقیه تنظیمات اختیاری‌اند و
# می‌توانی همه را بعداً داخل خود ربات با دستورها تنظیم کنی (نه در کد).

# توکن ربات از BotFather
BOT_TOKEN=PASTE_YOUR_TOKEN_HERE

# شناسه عددی تلگرام سازنده (ادمین اصلی). از @userinfobot بگیر
OWNER_ID=123456789

# مسیر دیتابیس SQLite
DATABASE_PATH=data/bot.sqlite3

# مقادیر پیش‌فرض (اختیاری)
DEFAULT_CREDITS=100
WARN_LIMIT=3
WARN_ACTION=kick            # kick یا ban
DEFAULT_LANGUAGE=fa         # fa یا en

# کلید سرویس پیش‌فرض هوش مصنوعی FreeModel (https://freemodel.dev)
# بعد از ساخت حساب و وریفای، کلید را از داشبورد FreeModel بگیر و اینجا بگذار
FREEMODEL_API_KEY=PASTE_FREEMODEL_KEY_HERE

# هزینه هر پیام هوشمند:
#   fixed  => هر پیام CREDIT_COST_PER_MESSAGE امتیاز کم می‌کند
#   tokens => هر TOKENS_PER_CREDIT توکن مصرفی = ۱ امتیاز
CREDIT_COST_MODE=fixed
CREDIT_COST_PER_MESSAGE=1
TOKENS_PER_CREDIT=1000

# پرامپت سیستمی پیش‌فرض هوش مصنوعی
DEFAULT_SYSTEM_PROMPT=تو یک دستیار مفید، مودب و دقیق هستی. پاسخ‌ها را کوتاه و روشن بده.

# کانال خصوصی برای لاگ اقدامات ادمین (اختیاری) مثل -1001234567890
LOG_CHANNEL_ID=